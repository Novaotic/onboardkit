# Copy this file to .env and fill in your values.

LOG_LEVEL=INFO

# A random secret string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# SMTP settings for sending the IT checklist email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@example.com

# Where to send completed IT requests (comma- or semicolon-separated)
IT_TEAM_EMAIL=it@example.com

# ── Admin authentication ───────────────────────────────────────────────────────
# Option A — Active Directory / LDAP (production)
# Leave LDAP_HOST blank for local dev (uses ADMIN_USERNAME / ADMIN_PASSWORD below).
LDAP_HOST=
LDAP_DOMAIN=example.com
LDAP_PORT=389
LDAP_GC_PORT=
LDAP_CONNECT_TIMEOUT=10
LDAP_RECEIVE_TIMEOUT=25
LDAP_BASE_DN=DC=example,DC=local
LDAP_ADMIN_GROUP=CN=IT Admins,OU=Groups,DC=example,DC=local
LDAP_BIND_DN=svc-portal@example.com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_EXTRA_BASES=
LDAP_DEBUG_DISCOVERY=

# Option B — Development-only admin login (NOT for production)
# Used automatically when LDAP_HOST is blank above.
# Credentials live in plain text in .env — anyone with server access can read them.
# For production, set LDAP_HOST and remove or leave ADMIN_PASSWORD unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
