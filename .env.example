# Copy this file to .env and fill in your values.

# development | production
# Production refuses to start unless LDAP_HOST is set.
APP_ENV=development

LOG_LEVEL=INFO

# A random secret string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SMTP settings for sending the IT checklist email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Where to send completed IT requests (comma- or semicolon-separated)
IT_TEAM_EMAIL=it@example.com

# ── Authentication ─────────────────────────────────────────────────────────────
# Option A — Active Directory / LDAP (required when APP_ENV=production)
# Leave LDAP_HOST blank for local dev (uses ADMIN_USERNAME / ADMIN_PASSWORD below).
LDAP_HOST=
LDAP_DOMAIN=example.com
LDAP_PORT=389
LDAP_GC_PORT=
LDAP_CONNECT_TIMEOUT=10
LDAP_RECEIVE_TIMEOUT=25
LDAP_BASE_DN=DC=example,DC=local
# Portal Users — can sign in and submit new-hire requests
LDAP_USERS_GROUP=CN=Portal Users,OU=Groups,DC=example,DC=local
# Portal Admin — same as Portal Users, plus /admin (role presets, etc.)
LDAP_ADMIN_GROUP=CN=Portal Admin,OU=Groups,DC=example,DC=local
LDAP_BIND_DN=svc-portal@example.com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_EXTRA_BASES=
LDAP_DEBUG_DISCOVERY=

# Option B — Development-only login (NOT for production)
# Used automatically when LDAP_HOST is blank above.
# Empty or default passwords are rejected. Set a unique local password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
