# Example: reverse proxy on a dedicated hostname.
# Copy fragments into /etc/nginx/conf.d/ or include from server { }.
#
# Replace:
#   onboard.example.org — DNS pointing at this host
#   ssl_certificate paths — your TLS certs (e.g. Let's Encrypt)

upstream onboardkit_backend {
    server 127.0.0.1:8001;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name onboard.example.org;

    ssl_certificate     /etc/pki/nginx/onboard.example.org-fullchain.pem;
    ssl_certificate_key /etc/pki/nginx/onboard.example.org-privkey.pem;

    access_log /var/log/nginx/onboardkit-access.log;
    error_log  /var/log/nginx/onboardkit-error.log;

    client_max_body_size 8M;

    location / {
        proxy_pass http://onboardkit_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }
}

# Optional HTTP → HTTPS redirect
# server {
#     listen 80;
#     listen [::]:80;
#     server_name onboard.example.org;
#     return 301 https://$host$request_uri;
# }
